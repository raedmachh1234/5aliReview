# ─────────────────────────────────────────────────────────────────────────────
# Store — environment variables
# Copy to .env.local for development. Never commit real values.
# Only variables starting with NEXT_PUBLIC_ reach the browser; nothing secret
# may use that prefix.
# ─────────────────────────────────────────────────────────────────────────────

# Public origin, used for canonical links, the sitemap and WhatsApp share text (no trailing slash).
# Set this to your real domain in production (e.g. https://myshop.tn) — Google uses it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console "HTML tag" verification code (just the content value).
# Optional: you can also paste it in Admin → Settings → Search engines, which takes priority.
GOOGLE_SITE_VERIFICATION=

# Admin panel (/admin). In development the password defaults to "admin".
# In production BOTH are required, or the admin area stays locked.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_PASSWORD=
SESSION_SECRET=

# ── Storage ──────────────────────────────────────────────────────────────────
# Default: a JSON file + uploaded photos in ./data (good for local use and a
# single server/VPS). Change the folder with DATA_DIR.
DATA_DIR=

# Supabase (recommended for Vercel and other serverless hosts, which have no
# persistent disk). Run supabase/migrations/0001_catalog.sql in your project
# first. Both values are server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
