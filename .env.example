# ─────────────────────────────────────────────────────────────────────────────
# 5ali Review — environment variables
# Copy to .env.local for development. Never commit real values.
# Variables starting with NEXT_PUBLIC_ are sent to the browser; nothing secret
# may use that prefix.
# ─────────────────────────────────────────────────────────────────────────────

# Public origin, used for card/QR URLs, canonical links and emails (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Leave both empty to run in DEMO MODE (in-memory sample data).
# The anon key is deliberately NOT NEXT_PUBLIC_: the browser never talks to Supabase,
# so keeping it server-only stops anyone calling the public RPCs directly (bypassing rate limits).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only — bypasses Row Level Security. Used only by the retention cron job.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (only for the Supabase CLI / migrations, not used by the app)
DATABASE_URL=

# Random secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
# Salt for hashing IP addresses in rate limiting (IPs are never stored)
IP_HASH_SALT=
# Protects /api/cron/retention (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
# Signs demo-mode session cookies (required if demo mode runs in production)
DEMO_SESSION_SECRET=
# Demo mode is refused in production unless this is "true"
ALLOW_DEMO_MODE=false

# Legal entity details shown in the legal pages and footer.
# Placeholders like "[Company legal name]" stay visible until these are set.
LEGAL_COMPANY_NAME=
LEGAL_REGISTRATION_NUMBER=
LEGAL_ADDRESS=
LEGAL_COUNTRY=Tunisia
LEGAL_CONTACT_EMAIL=hello@5ali.tn
LEGAL_PRIVACY_EMAIL=privacy@5ali.tn
LEGAL_BILLING_EMAIL=billing@5ali.tn
LEGAL_PHONE=
LEGAL_GOVERNING_LAW=
LEGAL_SUPERVISORY_AUTHORITY=
LEGAL_HOSTING_REGION=
LEGAL_LAST_UPDATED=2026-10-08
